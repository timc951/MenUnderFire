# Server Configuration
SERVER_PORT=8080

# Database Configuration
# IMPORTANT: Use the same database as your Kotlin backend
# so they share the schema created by Flyway migrations
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=menunderfire
DB_SSL_MODE=require

# CORS Configuration
CORS_ALLOWED_ORIGIN=http://localhost:8001

# Hit tracking token (must match VITE_HIT_TOKEN in frontend)
HIT_TOKEN=change-me-to-a-random-secret

# HMAC secret for signing testing agreement acceptance
AGREEMENT_HMAC_SECRET=change-me-to-a-random-secret
