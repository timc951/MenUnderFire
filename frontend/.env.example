# API Configuration
VITE_API_URL=http://localhost:7001/api

# Auth Configuration (Clerk)
# Get your publishable key from https://dashboard.clerk.com
VITE_AUTH_PUBLISHABLE_KEY=pk_test_xxx

# Hit tracking token (must match HIT_TOKEN in backend)
VITE_HIT_TOKEN=change-me-to-a-random-secret

# Debug Build (Docker only)
# Set to 'true' to disable minification and enable source maps
# VITE_DEBUG_BUILD=true
